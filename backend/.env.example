# Copy to .env for local use, or set these in your host (Render/Railway/etc.)

# Local MongoDB (default if unset):
# MONGO_URI=mongodb://127.0.0.1:27017/test

# MongoDB Atlas example:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/test?retryWrites=true&w=majority

MONGO_URI=mongodb://127.0.0.1:27017/test
JWT_SECRET=paste_a_long_random_hex_string_here
PORT=4000
